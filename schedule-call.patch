+                chip.accessibilityLabel = weekday + " " + (chip.mainLabel.text ?? "")
+                chip.accessibilityTraits = isSelected ? [.button, .selected] : (isDayAvailable ? [.button] : [.button, .notEnabled])
+            }
+            self.daysScroll.frame = CGRect(x: 0.0, y: y, width: width, height: dayChipSize.height)
+            self.daysScroll.contentSize = CGSize(width: sideInset * 2.0 + CGFloat(self.dayChips.count) * dayChipSize.width + CGFloat(self.dayChips.count - 1) * chipSpacing, height: dayChipSize.height)
+            self.daySelection.backgroundColor = green
+            self.daySelection.layer.cornerRadius = 16.0
+            containedTransition.updateFrame(view: self.daySelection, frame: self.dayChips[self.selectedDay].frame)
+            self.daysScroll.sendSubviewToBack(self.daySelection)
+            y += dayChipSize.height + 14.0
+
+            // The times.
+            let timeChipSize = CGSize(width: 72.0, height: 44.0)
+            for (index, chip) in self.timeChips.enumerated() {
+                let minutes = chip.tag
+                let isSelected = minutes == self.selectedMinutes
+                let isAvailable = self.isSlotAvailable(day: self.selectedDay, minutes: minutes)
+                chip.frame = CGRect(x: sideInset + CGFloat(index) * (timeChipSize.width + chipSpacing), y: 0.0, width: timeChipSize.width, height: timeChipSize.height)
+                chip.mainLabel.font = Font.with(size: 17.0, design: .round, weight: .semibold)
+                chip.mainLabel.text = stringForShortTimestamp(hours: Int32(minutes / 60), minutes: Int32(minutes % 60), dateTimeFormat: environment.dateTimeFormat)
+                chip.setChosen(isSelected, background: chipBackground, mainColor: isSelected ? .white : primary, topText: nil, animated: animated)
+                chip.mainLabel.frame = chip.bounds
+                chip.isEnabled = isAvailable
+                let alpha: CGFloat = isAvailable ? 1.0 : 0.35
+                if chip.alpha != alpha {
+                    containedTransition.updateAlpha(layer: chip.layer, alpha: alpha)
+                }
+                chip.accessibilityLabel = chip.mainLabel.text
+                chip.accessibilityTraits = isSelected ? [.button, .selected] : (isAvailable ? [.button] : [.button, .notEnabled])
+            }
+            self.timesScroll.frame = CGRect(x: 0.0, y: y, width: width, height: timeChipSize.height)
+            self.timesScroll.contentSize = CGSize(width: sideInset * 2.0 + CGFloat(self.timeChips.count) * timeChipSize.width + CGFloat(self.timeChips.count - 1) * chipSpacing, height: timeChipSize.height)
+            self.timeSelection.backgroundColor = green
+            self.timeSelection.layer.cornerRadius = 15.0
+            if let selectedChip = self.timeChips.first(where: { $0.tag == self.selectedMinutes }) {
+                containedTransition.updateFrame(view: self.timeSelection, frame: selectedChip.frame)
+            }
+            self.timesScroll.sendSubviewToBack(self.timeSelection)
+            y += timeChipSize.height + 22.0
+
+            // How long.
+            let durationFrame = CGRect(x: sideInset, y: y, width: width - sideInset * 2.0, height: 38.0)
+            self.durationContainer.frame = durationFrame
+            self.durationContainer.backgroundColor = chipBackground
+            let segmentWidth = floor((durationFrame.width - 6.0) / CGFloat(self.durationChips.count))
+            for (index, chip) in self.durationChips.enumerated() {
+                let isSelected = Int32(chip.tag) == self.selectedDuration
+                chip.frame = CGRect(x: 3.0 + CGFloat(index) * segmentWidth, y: 3.0, width: segmentWidth, height: 32.0)
+                chip.mainLabel.font = isSelected ? Font.semibold(14.0) : Font.medium(14.0)
+                chip.mainLabel.text = chip.tag == 60 ? strings.ScheduledCall_OneHour : strings.ScheduledCall_Minutes("\(chip.tag)").string
+                chip.mainLabel.textColor = primary
+                chip.mainLabel.frame = chip.bounds
+                chip.accessibilityLabel = chip.mainLabel.text
+                chip.accessibilityTraits = isSelected ? [.button, .selected] : [.button]
+                if isSelected {
+                    containedTransition.updateFrame(view: self.durationSelection, frame: chip.frame)
+                }
+            }
+            self.durationSelection.backgroundColor = theme.overallDarkAppearance ? UIColor(white: 1.0, alpha: 0.2) : .white
+            y = durationFrame.maxY + 26.0
+
+            // Schedule.
+            let buttonInsets = ContainerViewLayout.concentricInsets(bottomInset: environment.safeInsets.bottom, innerDiameter: 52.0, sideInset: 30.0)
+            let buttonSize = self.scheduleButton.update(
+                transition: transition,
+                component: AnyComponent(ButtonComponent(
+                    background: ButtonComponent.Background(
+                        style: .glass,
+                        color: green,
+                        foreground: .white,
+                        pressedColor: green.withMultipliedAlpha(0.9),
+                        cornerRadius: 26.0
+                    ),
+                    content: AnyComponentWithIdentity(id: "schedule", component: AnyComponent(Text(
+                        text: strings.ScheduledCall_Schedule,
+                        font: Font.semibold(17.0),
+                        color: .white
+                    ))),
+                    isEnabled: !self.isConfirming,
+                    tintWhenDisabled: false,
+                    action: { [weak self] in
+                        self?.confirm()
+                    }
+                )),
+                environment: {},
+                containerSize: CGSize(width: max(1.0, width - buttonInsets.left - buttonInsets.right), height: 52.0)
+            )
+            if let buttonView = self.scheduleButton.view {
+                if buttonView.superview == nil {
+                    self.addSubview(buttonView)
+                }
+                buttonView.frame = CGRect(origin: CGPoint(x: floor((width - buttonSize.width) * 0.5), y: y), size: buttonSize)
+            }
+            y += buttonSize.height + buttonInsets.bottom
+
+            if !self.didScrollToSelection && width > 0.0 {
+                self.didScrollToSelection = true
+                self.scrollToSelection(animated: false)
+            }
+            if !self.didAnimateIn {
+                self.didAnimateIn = true
+                self.animateIn()
+            }
+            return CGSize(width: width, height: y)
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<ViewControllerComponentContainer.Environment>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, state: state, environment: environment, transition: transition)
+    }
+}
+
+private final class ScheduledCallSheetComponent: CombinedComponent {
+    typealias EnvironmentType = ViewControllerComponentContainer.Environment
+
+    let context: AccountContext
+    let peer: EnginePeer
+
+    init(context: AccountContext, peer: EnginePeer) {
+        self.context = context
+        self.peer = peer
+    }
+
+    static func ==(lhs: ScheduledCallSheetComponent, rhs: ScheduledCallSheetComponent) -> Bool {
+        return lhs.context === rhs.context && lhs.peer == rhs.peer
+    }
+
+    static var body: Body {
+        let sheet = Child(SheetComponent<EnvironmentType>.self)
+        let animateOut = StoredActionSlot(Action<Void>.self)
+        let externalState = SheetComponent<EnvironmentType>.ExternalState()
+
+        return { context in
+            let environment = context.environment[EnvironmentType.self]
+            let controller = environment.controller
+
+            let sheet = sheet.update(
+                component: SheetComponent<EnvironmentType>(
+                    content: AnyComponent(ScheduledCallSheetContentComponent(
+                        context: context.component.context,
+                        peer: context.component.peer,
+                        confirm: { timestamp, duration in
+                            (controller() as? ScheduledCallScreen)?.finish(animated: true, animateOut: animateOut, result: (timestamp, duration))
+                        },
+                        close: {
+                            (controller() as? ScheduledCallScreen)?.finish(animated: true, animateOut: animateOut, result: nil)
+                        }
+                    )),
+                    style: .glass,
+                    backgroundColor: .color(environment.theme.actionSheet.opaqueItemBackgroundColor),
+                    followContentSizeChanges: true,
+                    clipsContent: true,
+                    autoAnimateOut: false,
+                    externalState: externalState,
+                    animateOut: animateOut,
+                    onPan: {},
+                    willDismiss: {}
+                ),
+                environment: {
+                    environment
+                    SheetComponentEnvironment(
+                        metrics: environment.metrics,
+                        deviceMetrics: environment.deviceMetrics,
+                        isDisplaying: environment.value.isVisible,
+                        isCentered: environment.presentsFloatingPanels,
+                        hasInputHeight: !environment.inputHeight.isZero,
+                        regularMetricsSize: CGSize(width: 430.0, height: 900.0),
+                        dismiss: { animated in
+                            (controller() as? ScheduledCallScreen)?.finish(animated: animated, animateOut: animateOut, result: nil)
+                        }
+                    )
+                },
+                availableSize: context.availableSize,
+                transition: context.transition
+            )
+            context.add(sheet.position(CGPoint(x: context.availableSize.width / 2.0, y: context.availableSize.height / 2.0)))
+            return context.availableSize
+        }
+    }
+}
+
+/// The form a call is scheduled in, from a profile: the day, the time and how long.
+public final class ScheduledCallScreen: ViewControllerComponentContainer {
+    private let completion: (Int32, Int32) -> Void
+    private var isFinishing = false
+
+    /// `completion` gets the time (seconds since 1970) and the length in minutes, once the form has gone.
+    public init(context: AccountContext, updatedPresentationData: (initial: PresentationData, signal: Signal<PresentationData, NoError>)? = nil, peer: EnginePeer, completion: @escaping (Int32, Int32) -> Void) {
+        self.completion = completion
+        super.init(
+            context: context,
+            component: ScheduledCallSheetComponent(context: context, peer: peer),
+            navigationBarAppearance: .none,
+            statusBarStyle: .ignore,
+            theme: .default,
+            updatedPresentationData: updatedPresentationData
+        )
+        self.navigationPresentation = .flatModal
+    }
+
+    required public init(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    fileprivate func finish(animated: Bool, animateOut: ActionSlot<Action<Void>>?, result: (Int32, Int32)?) {
+        guard !self.isFinishing else {
+            return
+        }
+        self.isFinishing = true
+        let completion = self.completion
+        let dismiss: () -> Void = { [weak self] in
+            if let self {
+                if let navigationController = self.navigationController as? NavigationController {
+                    navigationController.setViewControllers(navigationController.viewControllers.filter { $0 !== self }, animated: false)
+                } else {
+                    self.dismiss()
+                }
+            }
+            if let result {
+                completion(result.0, result.1)
+            }
+        }
+        if animated, let animateOut {
+            animateOut.invoke(Action { _ in dismiss() })
+        } else {
+            dismiss()
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Sources/Chat/ChatControllerScheduledCall.swift b/submodules/TelegramUI/Sources/Chat/ChatControllerScheduledCall.swift
new file mode 100644
index 0000000000..d60b92103c
--- /dev/null
+++ b/submodules/TelegramUI/Sources/Chat/ChatControllerScheduledCall.swift
@@ -0,0 +1,129 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import ChatPresentationInterfaceState
+import PresentationDataUtils
+import ScheduledCallModel
+import ScheduledCallScreen
+
+/// Calls the account is accepting just now: a second tap on Accept before the reply shows up does not send another one.
+private var scheduledCallAccepting = Set<ScheduledCallStore.Key>()
+
+extension ChatControllerImpl: ScheduledCallSendingController {
+    /// A scheduled call or its acceptance goes out as plain text, with no link preview.
+    private func scheduledCallMessage(text: String, entities: [MessageTextEntity], replyTo: EngineMessage.Id?) -> EnqueueMessage {
+        let attributes: [EngineMessage.Attribute] = [
+            TextEntitiesMessageAttribute(entities: entities),
+            OutgoingContentInfoMessageAttribute(flags: [.disableLinkPreviews])
+        ]
+        return .message(text: text, attributes: attributes, inlineStickers: [:], mediaReference: nil, threadId: self.chatLocation.threadId, replyToMessageId: replyTo.flatMap { EngineMessageReplySubject(messageId: $0, quote: nil, innerSubject: nil) }, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])
+    }
+
+    /// Whether a scheduled call or an acceptance can be sent to this chat now; if not, says why.
+    private func scheduledCallCanSend() -> Bool {
+        let state = self.presentationInterfaceState
+        let strings = self.presentationData.strings
+        let name = state.renderedPeer?.chatMainPeer.flatMap { EnginePeer($0).compactDisplayTitle } ?? ""
+        if state.peerIsBlocked {
+            self.present(textAlertController(context: self.context, updatedPresentationData: self.updatedPresentationData, title: nil, text: strings.ScheduledCall_Blocked(name).string, actions: [TextAlertAction(type: .defaultAction, title: strings.Common_OK, action: {})]), in: .window(.root))
+            return false
+        }
+        if state.isPremiumRequiredForMessaging || !canSendMessagesToChat(state) {
+            self.present(textAlertController(context: self.context, updatedPresentationData: self.updatedPresentationData, title: nil, text: strings.ScheduledCall_CantSend(name).string, actions: [TextAlertAction(type: .defaultAction, title: strings.Common_OK, action: {})]), in: .window(.root))
+            return false
+        }
+        return true
+    }
+
+    /// Sends a call scheduled in the profile of the one called, once this chat is on screen and knows its peer; its
+    /// card opens with an animation.
+    public func sendScheduledCall(_ call: ScheduledCall) {
+        guard self.chatLocation.peerId == call.calleeId, call.callerId == self.context.account.peerId else {
+            return
+        }
+        let (text, entities) = call.messageText(strings: self.presentationData.strings)
+        let message = self.scheduledCallMessage(text: text, entities: entities, replyTo: nil)
+        let send: () -> Void = { [weak self] in
+            guard let self, self.scheduledCallCanSend() else {
+                return
+            }
+            self.presentPaidMessageAlertIfNeeded(completion: { [weak self] postpone in
+                guard let self else {
+                    return
+                }
+                ScheduledCallRevealQueue.shared.add(call.id)
+                self.sendMessages(self.transformEnqueueMessages([message], silentPosting: false), postpone: postpone)
+            })
+        }
+        // The chat is ready and knows its peer (the paid messages alert and the checks need it), then a moment for the
+        // chat to settle on screen.
+        let _ = (self.ready.get()
+        |> filter { $0 }
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] _ in
+            self?.scheduledCallWhenPeerIsKnown(attempt: 0, {
+                Queue.mainQueue().after(0.3, send)
+            }, failed: { [weak self] in
+                guard let self else {
+                    return
+                }
+                self.present(textAlertController(context: self.context, updatedPresentationData: self.updatedPresentationData, title: nil, text: self.presentationData.strings.ScheduledCall_NotSent, actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+            })
+        })
+    }
+
+    /// Runs `action` once the chat knows its peer, or `failed` if it does not within five seconds.
+    private func scheduledCallWhenPeerIsKnown(attempt: Int, _ action: @escaping () -> Void, failed: @escaping () -> Void) {
+        if self.presentationInterfaceState.renderedPeer != nil {
+            action()
+        } else if attempt < 50 {
+            Queue.mainQueue().after(0.1, { [weak self] in
+                self?.scheduledCallWhenPeerIsKnown(attempt: attempt + 1, action, failed: failed)
+            })
+        } else {
+            failed()
+        }
+    }
+
+    /// The one called says yes: a reply to the call. The card is marked while the reply is being sent and for good once
+    /// it is delivered (see the bubble of the reply).
+    func acceptScheduledCall(message: EngineRawMessage) {
+        let accountPeerId = self.context.account.peerId
+        guard let call = ScheduledCall.parse(message: message, accountPeerId: accountPeerId), call.calleeId == accountPeerId else {
+            return
+        }
+        let key = ScheduledCallStore.Key(chatId: message.id.peerId, call: call)
+        guard !ScheduledCallStore.shared.currentIsAccepted(key), !scheduledCallAccepting.contains(key), self.scheduledCallCanSend() else {
+            return
+        }
+        let (text, entities) = ScheduledCallAcceptance.messageText(call: call, strings: self.presentationData.strings)
+        let reply = self.scheduledCallMessage(text: text, entities: entities, replyTo: message.id)
+        // A second tap while the paid messages alert (if any) is deciding does not send a second reply.
+        scheduledCallAccepting.insert(key)
+        Queue.mainQueue().after(5.0, {
+            scheduledCallAccepting.remove(key)
+        })
+        self.presentPaidMessageAlertIfNeeded(completion: { [weak self] postpone in
+            guard let self else {
+                return
+            }
+            self.sendMessages(self.transformEnqueueMessages([reply], silentPosting: false), postpone: postpone)
+        })
+    }
+
+    /// The time has come: a call to the other one.
+    func startScheduledCall(message: EngineRawMessage) {
+        let accountPeerId = self.context.account.peerId
+        guard let call = ScheduledCall.parse(message: message, accountPeerId: accountPeerId) else {
+            return
+        }
+        let otherId = call.callerId == accountPeerId ? call.calleeId : call.callerId
+        guard otherId != accountPeerId, call.isCallable(now: Int32(Date().timeIntervalSince1970)) else {
+            return
+        }
+        self.controllerInteraction?.callPeer(otherId, false)
+    }
+}
