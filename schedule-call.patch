diff --git a/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallMenuItem.swift b/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallMenuItem.swift
new file mode 100644
index 0000000000..cad25f6d4d
--- /dev/null
+++ b/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallMenuItem.swift
@@ -0,0 +1,185 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import ContextUI
+import TelegramPresentationData
+import ScheduledCall
+
+/// "Schedule Call" in a profile's menu. The first times it is seen it introduces itself: the row lights up green and
+/// grows a little, the clock's hands sweep round, the title comes in letter by letter and a NEW badge pops up.
+public final class ScheduledCallMenuItem: ContextMenuCustomItem {
+    private static let introductionsKey = "ScheduledCallMenuItem.Introductions"
+    private static let introductionCount = 3
+
+    let title: String
+    let badge: String
+    let action: () -> Void
+
+    public init(title: String, badge: String, action: @escaping () -> Void) {
+        self.title = title
+        self.badge = badge
+        self.action = action
+    }
+
+    public func node(presentationData: PresentationData, getController: @escaping () -> ContextControllerProtocol?, actionSelected: @escaping (ContextMenuActionResult) -> Void) -> ContextMenuCustomNode {
+        let introduces = UserDefaults.standard.integer(forKey: ScheduledCallMenuItem.introductionsKey) < ScheduledCallMenuItem.introductionCount
+        return ScheduledCallMenuItemNode(presentationData: presentationData, item: self, introduces: introduces, actionSelected: actionSelected)
+    }
+
+    fileprivate static func noteIntroduction() {
+        let count = UserDefaults.standard.integer(forKey: ScheduledCallMenuItem.introductionsKey)
+        UserDefaults.standard.set(count + 1, forKey: ScheduledCallMenuItem.introductionsKey)
+    }
+}
+
+private final class ScheduledCallMenuItemNode: ASDisplayNode, ContextMenuCustomNode {
+    private let item: ScheduledCallMenuItem
+    private let actionSelected: (ContextMenuActionResult) -> Void
+    private var presentationData: PresentationData
+    private let introduces: Bool
+    private var didIntroduce = false
+
+    private let tintView = UIView()
+    private let contentView = UIView()
+    private let clockView = ScheduledCallClockView()
+    private let titleView = ScheduledCallTextView()
+    private let badgeView = UIView()
+    private let badgeLabel = UILabel()
+
+    var needsSeparator: Bool {
+        return false
+    }
+
+    var needsPadding: Bool {
+        return true
+    }
+
+    init(presentationData: PresentationData, item: ScheduledCallMenuItem, introduces: Bool, actionSelected: @escaping (ContextMenuActionResult) -> Void) {
+        self.item = item
+        self.presentationData = presentationData
+        self.introduces = introduces
+        self.actionSelected = actionSelected
+        super.init()
+
+        self.isAccessibilityElement = true
+        self.accessibilityLabel = item.title
+        self.accessibilityTraits = [.button]
+    }
+
+    override func didLoad() {
+        super.didLoad()
+        self.tintView.isUserInteractionEnabled = false
+        self.tintView.alpha = 0.0
+        self.view.addSubview(self.tintView)
+        self.contentView.isUserInteractionEnabled = false
+        self.view.addSubview(self.contentView)
+        self.contentView.addSubview(self.clockView)
+        self.contentView.addSubview(self.titleView)
+        self.badgeLabel.textAlignment = .center
+        self.badgeView.addSubview(self.badgeLabel)
+        self.badgeView.isHidden = !self.introduces
+        self.contentView.addSubview(self.badgeView)
+        self.clockView.setTime(hour: 10, minute: 10, animated: false)
+        if self.introduces && !UIAccessibility.isReduceMotionEnabled {
+            // The row comes in by itself as the menu opens: until then it is empty.
+            self.clockView.alpha = 0.0
+            self.titleView.alpha = 0.0
+            self.badgeView.alpha = 0.0
+        }
+    }
+
+    override func didEnterHierarchy() {
+        super.didEnterHierarchy()
+        if self.introduces && !self.didIntroduce {
+            self.didIntroduce = true
+            ScheduledCallMenuItem.noteIntroduction()
+            // As the menu settles.
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.12, execute: { [weak self] in
+                self?.playIntroduction()
+            })
+        }
+    }
+
+    private var titleFont: UIFont {
+        return Font.regular(self.presentationData.listsFontSize.baseDisplaySize)
+    }
+
+    func updateLayout(constrainedWidth: CGFloat, constrainedHeight: CGFloat) -> (CGSize, (CGSize, ContainedViewLayoutTransition) -> Void) {
+        let theme = self.presentationData.theme
+        let iconSideInset: CGFloat = 20.0
+        let titleX = iconSideInset + 40.0
+        let verticalInset: CGFloat = 11.0
+        self.badgeLabel.attributedText = NSAttributedString(string: self.item.badge, attributes: [.font: Font.with(size: 11.0, design: .regular, weight: .bold), .kern: 0.4, .foregroundColor: UIColor.white])
+        self.badgeLabel.sizeToFit()
+        let badgeSize = CGSize(width: self.badgeLabel.bounds.width + 12.0, height: 18.0)
+        let badgeSpace = self.introduces ? badgeSize.width + 8.0 : 0.0
+        // The title takes what the badge leaves (it is cut short if it has to be), and the badge follows it.
+        let titleSize = ScheduledCallTextView.measure(text: NSAttributedString(string: self.item.title, attributes: [.font: self.titleFont]), width: max(1.0, constrainedWidth - titleX - 18.0 - badgeSpace), maxLines: 1)
+        let height = verticalInset * 2.0 + max(22.0, titleSize.height)
+        let minWidth = titleX + titleSize.width + badgeSpace + 18.0
+
+        return (CGSize(width: minWidth, height: height), { [weak self] size, transition in
+            guard let self else {
+                return
+            }
+            self.tintView.frame = CGRect(origin: CGPoint(), size: size)
+            self.tintView.backgroundColor = ScheduledCallColors.middle.withAlphaComponent(theme.overallDarkAppearance ? 0.22 : 0.12)
+            self.contentView.frame = CGRect(origin: CGPoint(), size: size)
+            let iconSize: CGFloat = 24.0
+            self.clockView.frame = CGRect(x: iconSideInset + floor((32.0 - iconSize) * 0.5), y: floor((size.height - iconSize) * 0.5), width: iconSize, height: iconSize)
+            self.clockView.update(size: CGSize(width: iconSize, height: iconSize), style: .line(theme.contextMenu.primaryColor))
+            let titleWidth = max(1.0, min(titleSize.width, size.width - titleX - 18.0 - badgeSpace))
+            self.titleView.update(text: NSAttributedString(string: self.item.title, attributes: [.font: self.titleFont, .foregroundColor: theme.contextMenu.primaryColor]), width: titleWidth, maxLines: 1)
+            self.titleView.frame = CGRect(origin: CGPoint(x: titleX, y: floor((size.height - titleSize.height) * 0.5)), size: CGSize(width: titleWidth, height: titleSize.height))
+            self.badgeView.frame = CGRect(x: self.titleView.frame.maxX + 8.0, y: floor((size.height - badgeSize.height) * 0.5), width: badgeSize.width, height: badgeSize.height)
+            self.badgeView.layer.cornerRadius = badgeSize.height * 0.5
+            self.badgeView.backgroundColor = ScheduledCallColors.middle
+            self.badgeLabel.frame = CGRect(origin: CGPoint(), size: badgeSize)
+        })
+    }
+
+    /// The row lights up green and grows a little as its parts come in: the clock pops up with its hands sweeping
+    /// round, the title rises letter by letter and the NEW badge springs out; then it all settles.
+    private func playIntroduction() {
+        guard self.isNodeLoaded else {
+            return
+        }
+        self.clockView.alpha = 1.0
+        self.titleView.alpha = 1.0
+        self.badgeView.alpha = 1.0
+        guard !UIAccessibility.isReduceMotionEnabled else {
+            return
+        }
+        self.tintView.alpha = 0.0
+        self.tintView.layer.animateKeyframes(values: [0.0, 1.0, 1.0, 0.0].map { $0 as NSNumber }, keyTimes: [0.0, 0.18, 0.65, 1.0].map { $0 as NSNumber }, duration: 1.6, keyPath: "opacity")
+        // The whole row grows a little as it fills, then settles.
+        self.contentView.layer.animateKeyframes(values: [0.94, 1.075, 1.075, 1.0].map { $0 as NSNumber }, keyTimes: [0.0, 0.3, 0.6, 1.0].map { $0 as NSNumber }, duration: 1.4, keyPath: "transform.scale", timingFunction: CAMediaTimingFunctionName.easeInEaseOut.rawValue)
+        self.clockView.layer.animateSpring(from: 0.2 as NSNumber, to: 1.0 as NSNumber, keyPath: "transform.scale", duration: 0.7, damping: 54.0)
+        self.clockView.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.18)
+        self.clockView.setTime(hour: 10, minute: 10, animated: true, extraTurns: 2)
+        self.clockView.ring(delay: 0.8)
+        let _ = self.titleView.animateLettersIn(delay: 0.08, stagger: 0.024)
+        if !self.badgeView.isHidden {
+            self.badgeView.layer.animateSpring(from: 0.1 as NSNumber, to: 1.0 as NSNumber, keyPath: "transform.scale", duration: 0.6, delay: 0.42, damping: 52.0)
+            self.badgeView.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.15, delay: 0.42)
+            scheduledCallAnimateSheen(over: self.badgeView, cornerRadius: self.badgeView.bounds.height * 0.5, delay: 0.85, duration: 0.7, alpha: 0.6)
+        }
+    }
+
+    func updateTheme(presentationData: PresentationData) {
+        self.presentationData = presentationData
+    }
+
+    func canBeHighlighted() -> Bool {
+        return true
+    }
+
+    func updateIsHighlighted(isHighlighted: Bool) {
+    }
+
+    func performAction() {
+        self.actionSelected(.dismissWithoutContent)
+        self.item.action()
+    }
+}
diff --git a/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallRollingLabel.swift b/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallRollingLabel.swift
new file mode 100644
index 0000000000..171cad3ed1
--- /dev/null
+++ b/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallRollingLabel.swift
@@ -0,0 +1,139 @@
+import Foundation
+import UIKit
+import Display
+import ScheduledCall
+
+/// A line of text whose letters change in place: what stays slides to its new spot, what goes falls away, and what
+/// comes rises in, so "Today, 11:00" turns into "Tomorrow, 10:00" letter by letter. Writing whose letters join or run
+/// from right to left changes as a whole line instead.
+final class ScheduledCallRollingLabel: UIView {
+    private final class Glyph {
+        let piece: String
+        let label: UILabel
+
+        init(piece: String) {
+            self.piece = piece
+            self.label = UILabel()
+            self.label.text = piece
+        }
+    }
+
+    /// Whether the letters of `text` can be set one by one: not for scripts that join letters, shape them together or
+    /// run from right to left.
+    private static func isPerLetter(_ text: String) -> Bool {
+        for scalar in text.unicodeScalars {
+            switch scalar.value {
+            case 0x0590 ... 0x08FF, 0x0900 ... 0x0DFF, 0x0E00 ... 0x0FFF, 0x1000 ... 0x109F, 0x1780 ... 0x17FF, 0x1800 ... 0x18AF, 0xA800 ... 0xABFF, 0xFB1D ... 0xFDFF, 0xFE70 ... 0xFEFF, 0x200F, 0x202B, 0x202E:
+                return false
+            default:
+                continue
+            }
+        }
+        return true
+    }
+
+    private var glyphs: [Glyph] = []
+    private(set) var textSize = CGSize()
+    private var font: UIFont = Font.regular(17.0)
+    private var color: UIColor = .black
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.isAccessibilityElement = true
+        self.accessibilityTraits = [.staticText, .updatesFrequently]
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    var text: String {
+        return self.glyphs.map { $0.piece }.joined()
+    }
+
+    /// Lays `text` out from the left and returns its size.
+    @discardableResult
+    func update(text: String, font: UIFont, color: UIColor, animated: Bool) -> CGSize {
+        let characters: [String] = ScheduledCallRollingLabel.isPerLetter(text) ? text.map { String($0) } : [text]
+        let old = self.glyphs.map { $0.piece }
+        let fontChanged = font != self.font
+        self.font = font
+        self.color = color
+
+        // What is the same at both ends stays; the middle changes.
+        var prefix = 0
+        while prefix < min(old.count, characters.count), old[prefix] == characters[prefix] {
+            prefix += 1
+        }
+        var suffix = 0
+        while suffix < min(old.count, characters.count) - prefix, old[old.count - 1 - suffix] == characters[characters.count - 1 - suffix] {
+            suffix += 1
+        }
+        let removed = fontChanged ? self.glyphs : Array(self.glyphs[prefix ..< self.glyphs.count - suffix])
+        var updated: [Glyph] = []
+        var added: [Glyph] = []
+        if fontChanged {
+            for character in characters {
+                let glyph = Glyph(piece: character)
+                updated.append(glyph)
+                added.append(glyph)
+            }
+        } else {
+            updated.append(contentsOf: self.glyphs[0 ..< prefix])
+            for character in characters[prefix ..< characters.count - suffix] {
+                let glyph = Glyph(piece: character)
+                updated.append(glyph)
+                added.append(glyph)
+            }
+            updated.append(contentsOf: self.glyphs[self.glyphs.count - suffix ..< self.glyphs.count])
+        }
+        self.glyphs = updated
+
+        let height = ceil(font.lineHeight)
+        var x: CGFloat = 0.0
+        let transition: ContainedViewLayoutTransition = animated ? .animated(duration: 0.45, curve: .spring) : .immediate
+        for glyph in self.glyphs {
+            glyph.label.font = font
+            glyph.label.textColor = color
+            let width = ceil((glyph.piece as NSString).size(withAttributes: [.font: font]).width)
+            let frame = CGRect(x: x, y: 0.0, width: width, height: height)
+            x += width
+            if let addedIndex = added.firstIndex(where: { $0 === glyph }) {
+                self.addSubview(glyph.label)
+                glyph.label.frame = frame
+                if animated {
+                    let delay = Double(addedIndex) * 0.025
+                    glyph.label.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.18, delay: delay)
+                    glyph.label.layer.animateSpring(from: NSValue(cgPoint: CGPoint(x: 0.0, y: height * 0.5)), to: NSValue(cgPoint: CGPoint()), keyPath: "position", duration: 0.5, delay: delay, damping: 78.0, additive: true)
+                    glyph.label.layer.animateSpring(from: 0.5 as NSNumber, to: 1.0 as NSNumber, keyPath: "transform.scale", duration: 0.5, delay: delay, damping: 70.0)
+                    scheduledCallAnimateBlurIn(glyph.label.layer, radius: 5.0, duration: 0.22, delay: delay)
+                }
+            } else {
+                transition.updateFrame(view: glyph.label, frame: frame)
+            }
+        }
+        for glyph in removed {
+            let label = glyph.label
+            if animated {
+                label.layer.animateAlpha(from: 1.0, to: 0.0, duration: 0.18, removeOnCompletion: false, completion: { [weak label] _ in
+                    label?.removeFromSuperview()
+                })
+                label.layer.animatePosition(from: CGPoint(), to: CGPoint(x: 0.0, y: -height * 0.4), duration: 0.24, removeOnCompletion: false, additive: true)
+                label.layer.animateScale(from: 1.0, to: 0.6, duration: 0.24, removeOnCompletion: false)
+            } else {
+                label.removeFromSuperview()
+            }
+        }
+        self.textSize = CGSize(width: ceil(x), height: height)
+        self.accessibilityLabel = text
+        return self.textSize
+    }
+
+    /// The letters come in one after another.
+    func animateIn(delay: Double) {
+        for (index, glyph) in self.glyphs.enumerated() {
+            scheduledCallAnimateRiseIn(glyph.label.layer, delay: delay + Double(index) * 0.022, offset: 14.0, scale: 0.7, blur: 6.0)
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallScreen.swift b/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallScreen.swift
new file mode 100644
index 0000000000..8c496065ca
--- /dev/null
+++ b/submodules/TelegramUI/Components/ScheduledCallScreen/Sources/ScheduledCallScreen.swift
@@ -0,0 +1,784 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import AvatarNode
+import TelegramPresentationData
+import TelegramStringFormatting
+import TextFormat
+import ComponentFlow
+import ViewControllerComponent
+import SheetComponent
+import ButtonComponent
+import GlassBarButtonComponent
+import BundleIconComponent
+import ScheduledCall
+import ScheduledCallModel
+
+/// A chat that can send a call that has just been scheduled (the chat controller).
+public protocol ScheduledCallSendingController: AnyObject {
+    func sendScheduledCall(_ call: ScheduledCall)
+}
+
+/// The time now (one place, so that it is the same clock everywhere in the form).
+private func scheduledCallNow() -> Date {
+    return Date()
+}
+
+private let slotStartMinutes = 8 * 60
+private let slotEndMinutes = 22 * 60
+private let slotStep = 30
+private let dayCount = 7
+
+/// A button of the form: a day, a time or a length.
+private final class ScheduledCallChipView: HighlightTrackingButton {
+    let topLabel = UILabel()
+    let mainLabel = UILabel()
+    /// Whether the chip is the chosen one (the green selection under it, white text).
+    private(set) var isChosen: Bool?
+
+    /// Sets the chip's background and text for being chosen or not. When the choice moves, the chip changes as the
+    /// selection slides under it: the one chosen keeps its fill and dark text until the selection reaches it, the one
+    /// left gets them back as the selection goes, both in a crossfade.
+    func setChosen(_ chosen: Bool, background: UIColor, mainColor: UIColor, topText: NSAttributedString?, animated: Bool) {
+        let changed = self.isChosen != nil && self.isChosen != chosen
+        self.isChosen = chosen
+        let fill = chosen ? UIColor.clear : background
+        guard changed && animated else {
+            self.backgroundColor = fill
+            self.mainLabel.textColor = mainColor
+            if let topText {
+                self.topLabel.attributedText = topText
+            }
+            return
+        }
+        let delay = chosen ? 0.07 : 0.0
+        UIView.animate(withDuration: 0.24, delay: delay, options: [.curveEaseInOut, .allowUserInteraction], animations: {
+            self.backgroundColor = fill
+        })
